# ── IDE ──
*.iml
/.idea
.DS_Store

# ── 构建产物 ──
# 注意：写 `/build` 只挡根目录，模块下的 app/build（实测 70MB）挡不住，
# 所以这里用不带斜杠的 `build/`，匹配任意层级。
build/
.gradle/
.kotlin/
/captures
*.hprof

# ── 本机配置与签名文件，绝对不能进仓库 ──
# local.properties 里有本机 Android SDK 绝对路径，别人拉下来是错的
local.properties
*.jks
*.keystore
# 签名口令明文，和 .jks 一样属于敏感文件
keystore.properties

# ── NDK ──
.externalNativeBuild
.cxx

# ── 工作区内部数据 ──
# 这里是开发过程中的笔记和记忆，不属于项目源码，也不该出现在公开仓库里
.workbuddy/
